@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001> a dici_onto:Building ;
    rdfs:label "Demo Flexible Building" ;
    dici_onto:hasAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/EVCount>,
        <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/ElectricityTariff>,
        <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/FootprintArea>,
        <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/GroundFloorArea>,
        <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/LumpedHeatCapacity>,
        <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/LumpedHeatResistance>,
        <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/OptimizationMonths>,
        <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/PVRoofCoverageRatio>,
        <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/PeakSpaceHeatingPower> ;
    dici_onto:hasBuildingEVCountAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/EVCount> ;
    dici_onto:hasBuildingElectricityTariffAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/ElectricityTariff> ;
    dici_onto:hasBuildingFootprintAreaAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/FootprintArea> ;
    dici_onto:hasBuildingGroundFloorAreaAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/GroundFloorArea> ;
    dici_onto:hasBuildingLumpedHeatCapacityAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/LumpedHeatCapacity> ;
    dici_onto:hasBuildingLumpedHeatResistanceAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/LumpedHeatResistance> ;
    dici_onto:hasBuildingOptimizationMonthsAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/OptimizationMonths> ;
    dici_onto:hasBuildingPVRoofCoverageRatioAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/PVRoofCoverageRatio> ;
    dici_onto:hasBuildingPeakSpaceHeatingPowerAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/PeakSpaceHeatingPower> .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Location/EmpaCampus> a dici_onto:Location ;
    rdfs:label "EMPA Campus" ;
    dici_onto:hasAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Location/EmpaCampus/WeatherEPW> ;
    dici_onto:hasLocationWeatherEPWAttribute <https://digicities.info/proj/BuildingFlexibility_EMPA/Location/EmpaCampus/WeatherEPW> .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/EVCount> a dici_onto:EVCount,
        dici_onto:PhysicalAttribute ;
    qudt:unit unit:COUNT ;
    qudt:value 1.0 ;
    dici_onto:hasUnitLabel "COUNT"^^xsd:string .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/ElectricityTariff> a dici_onto:CategoricalAttribute,
        dici_onto:ElectricityTariff,
        dici_onto:Flat .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/FootprintArea> a dici_onto:FootprintArea,
        dici_onto:PhysicalAttribute ;
    qudt:unit unit:M2 ;
    qudt:value 60.0 .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/GroundFloorArea> a dici_onto:GroundFloorArea,
        dici_onto:PhysicalAttribute ;
    qudt:unit unit:M2 ;
    qudt:value 200.0 .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/LumpedHeatCapacity> a dici_onto:LumpedHeatCapacity,
        dici_onto:PhysicalAttribute ;
    qudt:unit unit:KiloW-HR-PER-K ;
    qudt:value 50.0 ;
    dici_onto:hasUnitLabel "KiloW-HR-PER-K"^^xsd:string .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/LumpedHeatResistance> a dici_onto:LumpedHeatResistance,
        dici_onto:PhysicalAttribute ;
    qudt:unit unit:KiloW-PER-K ;
    qudt:value 0.5 ;
    dici_onto:hasUnitLabel "KiloW-PER-K"^^xsd:string .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/OptimizationMonths> a dici_onto:OptimizationMonths,
        dici_onto:PhysicalAttribute ;
    qudt:unit unit:MO ;
    qudt:value 2.0 ;
    dici_onto:hasUnitLabel "MO"^^xsd:string .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/PVRoofCoverageRatio> a dici_onto:PVRoofCoverageRatio,
        dici_onto:PhysicalAttribute ;
    qudt:unit unit:FRACTION ;
    qudt:value 0.3 ;
    dici_onto:hasUnitLabel "FRACTION"^^xsd:string .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Building/100001/PeakSpaceHeatingPower> a dici_onto:PeakSpaceHeatingPower,
        dici_onto:PhysicalAttribute ;
    qudt:unit unit:KiloW ;
    qudt:value 10.0 .

<https://digicities.info/proj/BuildingFlexibility_EMPA/Location/EmpaCampus/WeatherEPW> a dici_onto:DataPathAttribute,
        dici_onto:WeatherEPW ;
    dici_onto:hasDataPath "fribourg"^^xsd:string .

