@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

dici_onto:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf dici_onto:Component .

dici_onto:Dual a owl:Class ;
    rdfs:label "Dual" ;
    rdfs:subClassOf dici_onto:ElectricityTariff .

dici_onto:EVCount a owl:Class ;
    rdfs:label "Number of Electric Vehicles" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/COUNT> .

dici_onto:Flat a owl:Class ;
    rdfs:label "Flat" ;
    rdfs:subClassOf dici_onto:ElectricityTariff .

dici_onto:FootprintArea a owl:Class ;
    rdfs:label "Footprint Area" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/M2> .

dici_onto:GroundFloorArea a owl:Class ;
    rdfs:label "Ground Floor Area" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/M2> .

dici_onto:LumpedHeatCapacity a owl:Class ;
    rdfs:label "Lumped Heat Capacity" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/MegaJ-PER-K> .

dici_onto:LumpedHeatResistance a owl:Class ;
    rdfs:label "Lumped Heat Resistance" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/K-PER-W> .

dici_onto:OptimizationMonths a owl:Class ;
    rdfs:label "Optimization Months" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/MO> .

dici_onto:PVRoofCoverageRatio a owl:Class ;
    rdfs:label "PV Roof Coverage Ratio" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/FRACTION> .

dici_onto:PeakSpaceHeatingPower a owl:Class ;
    rdfs:label "Peak Space Heating Power" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/KiloW> .

dici_onto:Variable a owl:Class ;
    rdfs:label "Variable" ;
    rdfs:subClassOf dici_onto:ElectricityTariff .

dici_onto:WeatherEPW a owl:Class ;
    rdfs:label "Weather EPW" ;
    rdfs:subClassOf dici_onto:ResourceAttribute .

dici_onto:hasTurbineRatedPower a owl:ObjectProperty ;
    rdfs:domain dici_onto:Turbine ;
    rdfs:range dici_onto:RatedPower ;
    rdfs:subPropertyOf dici_onto:hasTurbineAttribute .

dici_onto:EnergyGeneratorAttribute a owl:Class ;
    rdfs:label "EnergyGenerator Attribute" ;
    rdfs:subClassOf dici_onto:ComponentAttribute .

dici_onto:TurbineAttribute a owl:Class ;
    rdfs:label "Turbine Attribute" ;
    rdfs:subClassOf dici_onto:EnergyGeneratorAttribute .

dici_onto:hasTurbineAttribute a owl:ObjectProperty ;
    rdfs:domain dici_onto:Turbine ;
    rdfs:range dici_onto:RatedPower ;
    rdfs:subPropertyOf dici_onto:hasEnergyGeneratorAttribute .

dici_onto:RatedPower a owl:Class ;
    rdfs:label "Rated Power" ;
    rdfs:subClassOf dici_onto:PhysicalAttribute,
        dici_onto:TurbineAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/MegaW> .

dici_onto:Turbine a owl:Class ;
    rdfs:label "Turbine" ;
    rdfs:subClassOf dici_onto:EnergyGenerator .

dici_onto:ElectricityTariff a owl:Class ;
    rdfs:label "Electricity Tariff" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:CategoricalAttribute .

dici_onto:BuildingAttribute a owl:Class ;
    rdfs:label "Building Attribute" ;
    rdfs:subClassOf dici_onto:Attribute .

